<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)..\..\</SolutionDir>
    <UnrealSharpPluginDir>$(MSBuildThisFileDirectory)</UnrealSharpPluginDir>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  
  <Import Project="$(UnrealSharpPluginDir)UnrealSharp.AOT.props" Condition="Exists('$(UnrealSharpPluginDir)UnrealSharp.AOT.props')" />
  <Import Project="$(UnrealSharpPluginDir)UnrealSharp.Build.props" Condition="Exists('$(UnrealSharpPluginDir)UnrealSharp.Build.props')" />

  <PropertyGroup>
    <UETargetPlatform Condition="'$(UETargetPlatform)' == ''">Win64</UETargetPlatform>
    <UnrealSharpManagedReferenceDirectory>$(UnrealSharpPluginDir)Binaries\Managed\$(TargetFramework)\</UnrealSharpManagedReferenceDirectory>
    <UnrealSharpManagedReferenceDirectory Condition="'$(UETargetType)' != 'Editor'">$(UnrealSharpPluginDir)Binaries\Managed\Precompiled\$(UETargetPlatform)\$(UETargetType)\$(UEBuildConfig)\$(TargetFramework)\</UnrealSharpManagedReferenceDirectory>
  </PropertyGroup>
  <Target Name="ValidateUnrealSharpManagedSdk" BeforeTargets="ResolveReferences" Condition="'$(UETargetType)' != 'Editor'">
    <Error Condition="!Exists('$(UnrealSharpManagedReferenceDirectory)UnrealSharp.dll')" Text="Missing UnrealSharp Game SDK: $(UnrealSharpManagedReferenceDirectory). Run PrecompileGameSdk." />
  </Target>

  <ItemGroup>
  
    <Reference Include="UnrealSharp">
      <HintPath>$(UnrealSharpManagedReferenceDirectory)UnrealSharp.dll</HintPath>
    </Reference>
	
	<Reference Include="UnrealSharp.Binds">
      <HintPath>$(UnrealSharpManagedReferenceDirectory)UnrealSharp.Binds.dll</HintPath>
    </Reference>
	
    <Reference Include="UnrealSharp.Core">
      <HintPath>$(UnrealSharpManagedReferenceDirectory)UnrealSharp.Core.dll</HintPath>
    </Reference>
	
    <Reference Include="UnrealSharp.Log">
      <HintPath>$(UnrealSharpManagedReferenceDirectory)UnrealSharp.Log.dll</HintPath>
    </Reference>

    <Reference Include="UnrealSharp.Plugins">
      <HintPath>$(UnrealSharpManagedReferenceDirectory)UnrealSharp.Plugins.dll</HintPath>
    </Reference>
    
  </ItemGroup>

  <ItemGroup Condition="'$(SkipIncludeAnalyzers)' == ''">
    <Analyzer Include="$(UnrealSharpPluginDir)Binaries\Managed\netstandard2.0\Newtonsoft.Json.dll" Private="false" CopyToPublishDirectory="Never" />
    <Analyzer Include="$(UnrealSharpPluginDir)Binaries\Managed\netstandard2.0\UnrealSharp.GlueGenerator.dll" Private="false" CopyToPublishDirectory="Never" />
    <Analyzer Include="$(UnrealSharpPluginDir)Binaries\Managed\netstandard2.0\UnrealSharp.Analyzers.dll" Private="false" CopyToPublishDirectory="Never" />
    <Analyzer Include="$(UnrealSharpPluginDir)Binaries\Managed\netstandard2.0\UnrealSharp.CodeFixer.dll" Private="false" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <Analyzer Include="$(UnrealSharpPluginDir)Binaries\Managed\netstandard2.0\UnrealSharp.SourceGenerators.dll" Private="false" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
